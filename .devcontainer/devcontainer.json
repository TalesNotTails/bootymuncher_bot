{
  "name": "bootymuncher_bot_devpod",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.6": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    }
  },
  "remoteUser": "node",
  "postCreateCommand": {
    "npm": "npm install"
  },
  "mounts": [
    "source=opencode-config,target=/home/node/.config/opencode,type=volume",
    "source=opencode-data,target=/home/node/.local/share/opencode,type=volume"
  ],
  "runArgs": ["--security-opt=label=disable"]
}

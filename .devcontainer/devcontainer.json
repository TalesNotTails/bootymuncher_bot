{
  "name": "bootymuncher_bot_devpod",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.5.6": {
      "installZsh": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true,
      "userUid": "3000",
      "userGid": "3000"
    }
  },
  "postCreateCommand": {
    "npm": "npm install"
  },
  "mounts": [
    "source=${localEnv:HOME}/.config/opencode,target=/root/.config/opencode,type=bind",
    "source=opencode-data,target=/root/.local/share/opencode,type=volume"
  ]
}

APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
GUILD_ID=

MC_HOSTNAME=
MC_INSTANCE_NAME=

# /watch: channel where stock alerts are posted (required to enable /watch)
WATCH_CHANNEL_ID=
# How often to re-check watched pages, in minutes (default 10)
WATCH_INTERVAL_MINUTES=10

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bootymuncherbot

# --- Railway ---
# Don't set the POSTGRES_* vars above on Railway. Instead link a PostgreSQL
# service to your app service; Railway injects DATABASE_URL (and PGHOST,
# PGPORT, PGUSER, PGPASSWORD, PGDATABASE) automatically. To reference them
# explicitly in the app service variables tab, use:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# or the internal hostnames (postgres.railway.internal) via the individual vars.
